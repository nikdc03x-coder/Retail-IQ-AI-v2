# RetailIQ AI V2 — Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml (which is gitignored) for local development,
# or enter these key-value pairs into your Streamlit Community Cloud app Settings > Secrets.

# Google Gemini API Key (Required for live generative function-calling reasoning)
# Obtain a free-tier key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Configurable Gemini Model (Default is gemini-2.0-flash; gemini-2.5-flash or gemini-1.5-flash are also supported)
GEMINI_MODEL = "gemini-2.0-flash"

